# SITREP — contoh environment. Salin: cp .env.example .env lalu isi kredensial.
# JANGAN pernah commit .env (berisi secret asli). File ini HANYA placeholder.

# --- API keys (isi dengan kunci asli) ---
TOMTOM_API_KEY=your-key-here
AISSTREAM_API_KEY=your-key-here
NASA_FIRMS_API_KEY=your-key-here
FIRECRAWL_API_KEY=your-key-here

# --- Sesi X / Twitter (wajib untuk /api/x; dukung multi-akun untuk rotasi 429) ---
X_AUTH_TOKEN=your-key-here
X_CT0=your-key-here
# Opsional: akun burner tambahan (X_AUTH_TOKEN_2..10 + X_CT0_2..10, atau pisahkan koma)
X_AUTH_TOKEN_2=
X_CT0_2=
# Opsional: override bearer & query-id X
X_BEARER=your-key-here
X_QUERY_ID=your-key-here

# --- Threads session (opsional — mode login untuk yield lebih banyak) ---
# Ambil dari cookie threads.com di browser (DevTools → Application → Cookies).
# Kosongkan semua = worker jalan logged-out seperti biasa.
TH_SESSIONID=
TH_CSRFTOKEN=
TH_DS_USER_ID=
TH_MID=
TH_RUR=

# --- Server & Keamanan ---
# Port listen; kosongkan untuk default 8787
PORT=
# Token gate API untuk mode lokal / kontrol operator opsional (x-sitrep-token header).
# Di mode lokal (SITREP_PUBLIC!=1 & SITREP_USERS kosong): token di-inject ke GET /.
# Di mode publik (SITREP_PUBLIC=1 / Railway): dashboard terbuka tanpa login dan token TIDAK di-inject ke HTML.
SITREP_TOKEN=
# Role untuk SITREP_TOKEN bila dipakai sebagai operator headless (default: admin)
SITREP_TOKEN_ROLE=admin
# Mode dashboard OSINT publik read-only (set 1 untuk paksa publik tanpa login; otomatis aktif di Railway/Render/Fly)
SITREP_PUBLIC=
# Opsional: aktifkan login sesi multi-user HANYA untuk deployment privat (kosongkan untuk dashboard publik tanpa login)
SITREP_USERS=
# Secret HMAC cookie sesi (jika SITREP_USERS dipakai)
SITREP_AUTH_SECRET=
# Set 1 jika berjalan di belakang reverse proxy tepercaya (Nginx/Railway/Cloudflare) untuk IP rate-limit
SITREP_TRUST_PROXY=
# Set 1 saat berjalan di belakang Cloudflare Tunnel (cloudflared) agar CF-Connecting-IP diprioritaskan
SITREP_TRUST_CF=
# Bind host: untuk Cloudflare Tunnel lokal (cloudflared -> localhost), set 127.0.0.1 agar port origin tidak terekspos langsung ke publik
SITREP_HOST=
# Set 1 di macOS agar start.sh menjaga Mac tetap bangun (caffeinate) selama server berjalan
SITREP_KEEP_AWAKE=
# Jumlah hop proxy tepercaya di X-Forwarded-For (default: 1)
SITREP_TRUSTED_HOPS=
# Direktori persistensi runtime (default: ./data)
SITREP_DATA_DIR=
# Path PEM CA tambahan tepercaya (opsional, pisah koma) bila upstream pakai CA korporat/privat yang sah.
SITREP_EXTRA_CA=

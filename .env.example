# SITREP — contoh environment. Salin: cp .env.example .env lalu isi kredensial.
# JANGAN pernah commit .env (berisi secret asli). File ini HANYA placeholder.

# --- API keys (isi dengan kunci asli) ---
TOMTOM_API_KEY=your-key-here
AISSTREAM_API_KEY=your-key-here
NASA_FIRMS_API_KEY=your-key-here
FIRECRAWL_API_KEY=your-key-here
# Opsional: Copernicus Data Space Ecosystem (Sentinel-2 L2A 10m via OAuth client_credentials)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Opsional tuning cache/kuota Copernicus (default: 300 req/hari, 9500/bln, TTL 24 jam, max disk 256 MiB)
CDSE_DAILY_CAP=300
CDSE_CACHE_TTL_MS=86400000

# --- Sesi X / Twitter (wajib untuk /api/x; dukung multi-akun untuk rotasi 429) ---
X_AUTH_TOKEN=your-key-here
X_CT0=your-key-here
# Opsional: akun burner tambahan (X_AUTH_TOKEN_2..10 + X_CT0_2..10, atau pisahkan koma)
X_AUTH_TOKEN_2=
X_CT0_2=
# Opsional: override bearer & query-id X
X_BEARER=your-key-here
X_QUERY_ID=your-key-here

# --- Threads session (opsional — mode login untuk yield lebih banyak) ---
# Ambil dari cookie threads.com di browser (DevTools → Application → Cookies).
# Kosongkan semua = worker jalan logged-out seperti biasa.
TH_SESSIONID=
TH_CSRFTOKEN=
TH_DS_USER_ID=
TH_MID=
TH_RUR=

# --- Server & Keamanan ---
# Port listen; kosongkan untuk default 8787
PORT=
# Token gate API untuk mode lokal / kontrol operator opsional (x-sitrep-token header).
# Di mode lokal (SITREP_PUBLIC!=1 & SITREP_USERS kosong): token di-inject ke GET /.
# Di mode publik (SITREP_PUBLIC=1 / Railway): dashboard terbuka tanpa login dan token TIDAK di-inject ke HTML.
SITREP_TOKEN=
# Role untuk SITREP_TOKEN bila dipakai sebagai operator headless (default: admin)
SITREP_TOKEN_ROLE=admin
# Mode dashboard OSINT publik read-only (set 1 untuk paksa publik tanpa login; otomatis aktif di Railway/Render/Fly)
SITREP_PUBLIC=
# Opsional: aktifkan login sesi multi-user HANYA untuk deployment privat (kosongkan untuk dashboard publik tanpa login)
SITREP_USERS=
# Secret HMAC cookie sesi (jika SITREP_USERS dipakai)
SITREP_AUTH_SECRET=
# Set 1 jika berjalan di belakang reverse proxy tepercaya (Nginx/Railway/Cloudflare) untuk IP rate-limit
SITREP_TRUST_PROXY=
# Set 1 saat berjalan di belakang Cloudflare Tunnel (cloudflared) agar CF-Connecting-IP diprioritaskan
SITREP_TRUST_CF=
# Bind host: untuk Cloudflare Tunnel lokal (cloudflared -> localhost), set 127.0.0.1 agar port origin tidak terekspos langsung ke publik
SITREP_HOST=
# Set 1 di macOS agar start.sh menjaga Mac tetap bangun (caffeinate) selama server berjalan
SITREP_KEEP_AWAKE=
# Jumlah hop proxy tepercaya di X-Forwarded-For (default: 1)
SITREP_TRUSTED_HOPS=
# Direktori persistensi runtime (default: ./data)
SITREP_DATA_DIR=
# Path PEM CA tambahan tepercaya (opsional, pisah koma) bila upstream pakai CA korporat/privat yang sah.
SITREP_EXTRA_CA=

# --- Fitur opsional ---
# API key Jina AI (reader fallback untuk situs anti-bot, alternatif Firecrawl)
JINA_API_KEY=
# Proxy upstream opsional untuk fetch RSS/CCTV (format URL; Custom proxy atau PROXY_URL)
CUSTOM_PROXY_URL=
PROXY_URL=
# Override path binary ffmpeg untuk snapshot CCTV (default: PATH)
FFMPEG_PATH=

# --- Copernicus CDSE (Sentinel-2) ---
# CDSE_DAILY_CAP=1200
# CDSE_MONTH_CAP=9500
# CDSE_CACHE_TTL_MS=86400000
# CDSE_CACHE_MAX_BYTES=
# CDSE_LOOKBACK_DAYS=
# Alias: COPERNICUS_CLIENT_ID / COPERNICUS_CLIENT_SECRET

# --- NLP adapter eksternal (opsional, default offline deterministik) ---
# SITREP_NLP_PROVIDER=
# SITREP_NLP_ENDPOINT=
# SITREP_NLP_API_KEY=
# SITREP_NLP_MODEL=
# SITREP_NLP_TIMEOUT_MS=

# --- Tuning runtime ---
# SITREP_RSS_CONCURRENCY=8          # paralelisme fetch RSS (default 8)
# SITREP_RSS_JITTER_MS=250          # jitter acak antar siklus feed (ms)
# SITREP_DOC_CACHE_BYTES=            # cap byte docCache artikel (default ~1MB HTML + jit)
# SITREP_HLS_MAX_ACTIVE=48           # stream HLS aktif bersamaan (gateway CCTV)
# SITREP_HLS_PER_HOST=8              # stream aktif per host upstream
# SITREP_HLS_MAX_QUEUE=64            # antrian stream
# SITREP_HLS_SNAP_ACTIVE=2           # snapshot paralel
# SITREP_HLS_SNAP_QUEUE=16           # antrian snapshot
# SITREP_HLS_GLOBAL_BPS=47185920     # budget bandwidth global (~45 MiB/s)
# SITREP_HLS_GLOBAL_BURST=188743680  # burst budget (~180 MiB)
# SITREP_HLS_CACHE_BYTES=67108864    # cap cache segmen (~64 MiB)
# SITREP_MAC_PROFILE=1               # profil gateway hemat resource macOS
# SITREP_NO_WESERV=1                 # matikan proxy images.weserv.nl
# SITREP_NO_SUPERVISOR=1             # bypass loop supervisor di start.sh
# SITREP_DISABLE_QUERY_TOKEN=1       # nonaktifkan auth ?token= di query string
# SITREP_ALLOW_LAN_TOKEN=1           # izinkan bind non-loopback di mode token lokal (HATI-HATI)

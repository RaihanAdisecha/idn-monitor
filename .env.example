# SITREP — contoh environment. Salin: cp .env.example .env lalu isi kredensial.
# JANGAN pernah commit .env (berisi secret asli). File ini HANYA placeholder.

# --- API keys (isi dengan kunci asli) ---
TOMTOM_API_KEY=your-key-here
AISSTREAM_API_KEY=your-key-here
NASA_FIRMS_API_KEY=your-key-here
FIRECRAWL_API_KEY=your-key-here

# --- Sesi X / Twitter (wajib untuk /api/x) ---
X_AUTH_TOKEN=your-key-here
X_CT0=your-key-here
# Opsional: override bearer & query-id X
X_BEARER=your-key-here
X_QUERY_ID=your-key-here

# --- Threads session (opsional — mode login untuk yield lebih banyak) ---
# Ambil dari cookie threads.com di browser (DevTools → Application → Cookies).
# Kosongkan semua = worker jalan logged-out seperti biasa.
TH_SESSIONID=
TH_CSRFTOKEN=
TH_DS_USER_ID=
TH_MID=
TH_RUR=

# --- Server ---
# Port listen; kosongkan untuk default 8787
PORT=
# Token gate untuk /api/* (kecuali /api/ping), /img, /hls, /vhs.
# Kosongkan → token acak per-boot, di-inject ke <meta name="sitrep-token"> di GET /.
SITREP_TOKEN=
# Set ke 1 untuk mematikan validasi TLS. Hanya untuk debugging; jangan di produksi.
SITREP_INSECURE_TLS=
